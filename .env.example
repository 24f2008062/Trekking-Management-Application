# ==============================================================================
# TREKKING MANAGEMENT APPLICATION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Flask Security
FLASK_SECRET_KEY=change_me_to_a_cryptographically_secure_random_string
FLASK_DEBUG=0
PORT=5000

# Relational Database URI (Default: SQLite app.db)
# PostgreSQL / MySQL Example:
# DATABASE_URL=postgresql://user:password@hostname:5432/trekking_db

# Enterprise Redis Connection (Optional - automatic transparent fallback if offline)
# REDIS_URL=redis://default:password@hostname:6379/0

# Default System Administrator (Auto-provisioned on initial boot if empty)
ADMIN_DEFAULT_EMAIL=admin@admin.com
ADMIN_DEFAULT_PASSWORD=admin@123

